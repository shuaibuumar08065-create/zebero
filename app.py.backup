# ==========================================
# GOOGLE CALLBACK
# ==========================================

@app.route("/auth/google/callback")
def google_callback():

    # --------------------------------------
    # Get authorization code
    # --------------------------------------

    code = request.args.get(
        "code"
    )

    if not code:

        return (
            "Google login failed.",
            400,
        )


    # --------------------------------------
    # Exchange code for token
    # --------------------------------------

    token = exchange_code_for_token(
        code
    )

    if "access_token" not in token:

        return (
            str(token),
            400,
        )


    # --------------------------------------
    # Decode Google ID token
    # --------------------------------------

    try:

        google_user = jwt.decode(
            token["id_token"],
            options={
                "verify_signature": False,
            },
            algorithms=[
                "RS256",
            ],
        )

    except Exception:

        return (
            "Invalid Google account information.",
            400,
        )


    # --------------------------------------
    # Get Google user information
    # --------------------------------------

    google_id = google_user.get(
        "sub"
    )

    email = google_user.get(
        "email"
    )

    username = google_user.get(
        "name"
    )

    picture = google_user.get(
        "picture",
        "",
    )


    if not google_id or not email:

        return (
            "Google account information is incomplete.",
            400,
        )


    # --------------------------------------
    # Default username
    # --------------------------------------

    if not username:

        username = email.split(
            "@"
        )[0]


    # --------------------------------------
    # Find user by Google ID
    # --------------------------------------

    user = get_user_by_google_id(
        google_id
    )


    # --------------------------------------
    # User does not exist by Google ID
    # --------------------------------------

    if not user:

        # ----------------------------------
        # Check email
        # ----------------------------------

        user = get_user_by_email(
            email
        )


        # ----------------------------------
        # Create new user
        # ----------------------------------

        if not user:

            create_user(
                google_id,
                username,
                email,
                picture,
            )

            user = get_user_by_google_id(
                google_id
            )


            # ------------------------------
            # Create referral code
            # ------------------------------

            if user:

                create_referral_code(
                    user["id"]
                )


    # --------------------------------------
    # User still not found
    # --------------------------------------

    if not user:

        return (
            "Unable to create or find your account.",
            500,
        )


    # --------------------------------------
    # Save user in session
    # --------------------------------------

    session["user"] = {
        "id": user["id"],
        "username": user["username"],
        "email": user["email"],
        "picture": user["picture"],
        "balance": user["balance"],
    }


    # --------------------------------------
    # Go to dashboard
    # --------------------------------------

    return redirect(
        url_for("dashboard")
    )
# ==========================================
# DASHBOARD
# ==========================================

@app.route("/dashboard")
def dashboard():

    # --------------------------------------
    # Check login
    # --------------------------------------

    if "user" not in session:

        return redirect(
            url_for("index")
        )


    # --------------------------------------
    # Get fresh user data
    # --------------------------------------

    user = get_user(
        session["user"]["id"]
    )


    if not user:

        session.clear()

        return redirect(
            url_for("index")
        )


    # --------------------------------------
    # Update session
    # --------------------------------------

    session["user"] = {
        "id": user["id"],
        "username": user["username"],
        "email": user["email"],
        "picture": user["picture"],
        "balance": user["balance"],
    }


    # --------------------------------------
    # Dashboard
    # --------------------------------------

    return render_template(
        "dashboard.html",
        user=session["user"],
    )


# ==========================================
# EARN
# ==========================================

@app.route("/earn")
def earn():

    # --------------------------------------
    # Check login
    # --------------------------------------

    if "user" not in session:

        return redirect(
            url_for("index")
        )


    user_id = session["user"]["id"]


    # --------------------------------------
    # Get task type
    # --------------------------------------

    task_type = request.args.get(
        "type",
        "normal",
    )


    # --------------------------------------
    # Get upgrade levels
    # --------------------------------------

    levels = get_upgrade_levels(
        user_id
    )


    # ======================================
    # NORMAL TASKS
    # ======================================

    if task_type == "normal":

        tasks = []


        for task in get_tasks_by_type(
            "normal"
        ):

            task = dict(task)


            # ------------------------------
            # Verification status
            # ------------------------------

            task[
                "verification_status"
            ] = get_user_task_status(
                user_id,
                task["id"],
            )


            tasks.append(
                task
            )


    # ======================================
    # UPGRADE TASKS
    # ======================================

    else:

        tasks = []


        for level, quantity in levels.items():

            user_tasks = get_tasks_by_type(
                "upgrade",
                level,
            )


            for task in user_tasks:

                task = dict(task)


                # --------------------------
                # Verification status
                # --------------------------

                task[
                    "verification_status"
                ] = get_user_task_status(
                    user_id,
                    task["id"],
                )


                # --------------------------
                # Upgrade reward
                # --------------------------

                task["reward"] = (
                    float(task["reward"])
                    * quantity
                )


                task["quantity"] = quantity


                tasks.append(
                    task
                )


    # --------------------------------------
    # Earn page
    # --------------------------------------

    return render_template(
        "earn.html",
        tasks=tasks,
        task_type=task_type,
        levels=levels,
    )
