import sqlite3
import uuid
from datetime import datetime, timedelta


DB_NAME = "users.db"


# =========================================================
# DATABASE
# =========================================================

def get_db():
    conn = sqlite3.connect(
        DB_NAME,
        timeout=30,
    )

    conn.row_factory = sqlite3.Row

    return conn


# =========================================================
# CREATE TABLE
# =========================================================

def create_deposit_table():
    conn = get_db()
    cur = conn.cursor()

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS deposits (
            id INTEGER PRIMARY KEY AUTOINCREMENT,

            user_id INTEGER NOT NULL,

            tx_ref TEXT UNIQUE NOT NULL,

            flw_ref TEXT,

            amount REAL NOT NULL,

            currency TEXT DEFAULT 'NGN',

            account_number TEXT,

            bank_name TEXT,

            account_name TEXT,

            status TEXT DEFAULT 'pending',

            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

            expires_at TIMESTAMP,

            paid_at TIMESTAMP
        )
        """
    )

    conn.commit()
    conn.close()


# =========================================================
# CREATE DEPOSIT
# =========================================================

def create_deposit(user_id, amount):

    tx_ref = (
        "ZEBERO-"
        + uuid.uuid4().hex[:16].upper()
    )

    expires_at = (
        datetime.now()
        + timedelta(minutes=10)
    )

    conn = get_db()
    cur = conn.cursor()

    cur.execute(
        """
        INSERT INTO deposits (
            user_id,
            tx_ref,
            amount,
            currency,
            status,
            expires_at
        )
        VALUES (?, ?, ?, ?, ?, ?)
        """,
        (
            user_id,
            tx_ref,
            float(amount),
            "NGN",
            "pending",
            expires_at,
        ),
    )

    deposit_id = cur.lastrowid

    conn.commit()
    conn.close()

    return {
        "id": deposit_id,
        "tx_ref": tx_ref,
        "expires_at": expires_at,
    }


# =========================================================
# GET DEPOSIT
# =========================================================

def get_deposit(tx_ref):

    conn = get_db()
    cur = conn.cursor()

    cur.execute(
        """
        SELECT *
        FROM deposits
        WHERE tx_ref = ?
        LIMIT 1
        """,
        (tx_ref,),
    )

    row = cur.fetchone()

    conn.close()

    return row


# =========================================================
# SAVE VIRTUAL ACCOUNT
# =========================================================

def save_virtual_account(
    tx_ref,
    account_number,
    bank_name,
    account_name,
):

    conn = get_db()
    cur = conn.cursor()

    cur.execute(
        """
        UPDATE deposits

        SET
            account_number = ?,
            bank_name = ?,
            account_name = ?

        WHERE tx_ref = ?
        """,
        (
            account_number,
            bank_name,
            account_name,
            tx_ref,
        ),
    )

    changed = cur.rowcount

    conn.commit()
    conn.close()

    return changed > 0


# =========================================================
# EXPIRE DEPOSIT
# =========================================================

def expire_deposit_if_needed(tx_ref):

    conn = get_db()
    cur = conn.cursor()

    cur.execute(
        """
        UPDATE deposits

        SET status = 'expired'

        WHERE tx_ref = ?

        AND status = 'pending'

        AND expires_at IS NOT NULL

        AND datetime(expires_at) <= datetime('now')
        """,
        (tx_ref,),
    )

    changed = cur.rowcount

    conn.commit()
    conn.close()

    return changed > 0


# =========================================================
# COMPLETE DEPOSIT
# =========================================================

def complete_deposit(
    tx_ref,
    flw_ref=None,
):

    conn = get_db()
    cur = conn.cursor()

    try:

        # -------------------------------------------------
        # Get deposit
        # -------------------------------------------------

        cur.execute(
            """
            SELECT *
            FROM deposits
            WHERE tx_ref = ?
            LIMIT 1
            """,
            (tx_ref,),
        )

        deposit = cur.fetchone()

        if not deposit:
            return {
                "success": False,
                "message": "Deposit not found.",
            }

        # -------------------------------------------------
        # Already successful
        # -------------------------------------------------

        if deposit["status"] == "successful":

            return {
                "success": True,
                "already_completed": True,
                "amount": float(
                    deposit["amount"]
                ),
            }

        # -------------------------------------------------
        # Only pending
        # -------------------------------------------------

        if deposit["status"] != "pending":

            return {
                "success": False,
                "message": (
                    f"Deposit status is "
                    f"{deposit['status']}."
                ),
            }

        # -------------------------------------------------
        # Expiration
        # -------------------------------------------------

        expires_at = deposit["expires_at"]

        if expires_at:

            try:

                expiry = datetime.fromisoformat(
                    str(expires_at)
                )

                if datetime.now() >= expiry:

                    cur.execute(
                        """
                        UPDATE deposits

                        SET status = 'expired'

                        WHERE tx_ref = ?

                        AND status = 'pending'
                        """,
                        (tx_ref,),
                    )

                    conn.commit()

                    return {
                        "success": False,
                        "message": "Deposit has expired.",
                    }

            except (
                ValueError,
                TypeError,
            ):
                pass

        # -------------------------------------------------
        # Get user
        # -------------------------------------------------

        user_id = deposit["user_id"]

        cur.execute(
            """
            SELECT balance
            FROM users
            WHERE id = ?
            LIMIT 1
            """,
            (user_id,),
        )

        user = cur.fetchone()

        if not user:

            return {
                "success": False,
                "message": "User not found.",
            }

        current_balance = float(
            user["balance"] or 0
        )

        amount = float(
            deposit["amount"]
        )

        new_balance = (
            current_balance + amount
        )

        # -------------------------------------------------
        # Lock logically by changing pending -> successful
        # -------------------------------------------------

        cur.execute(
            """
            UPDATE deposits

            SET
                status = 'successful',
                flw_ref = ?,
                paid_at = CURRENT_TIMESTAMP

            WHERE tx_ref = ?

            AND status = 'pending'
            """,
            (
                flw_ref,
                tx_ref,
            ),
        )

        changed = cur.rowcount

        # Another webhook/request already processed it
        if changed != 1:

            conn.rollback()

            return {
                "success": True,
                "already_completed": True,
                "amount": amount,
            }

        # -------------------------------------------------
        # Credit wallet
        # -------------------------------------------------

        cur.execute(
            """
            UPDATE users

            SET balance = ?

            WHERE id = ?
            """,
            (
                new_balance,
                user_id,
            ),
        )

        if cur.rowcount != 1:

            conn.rollback()

            return {
                "success": False,
                "message": "Could not update user balance.",
            }

        # -------------------------------------------------
        # Commit both
        # -------------------------------------------------

        conn.commit()

        return {
            "success": True,
            "already_completed": False,
            "amount": amount,
            "new_balance": new_balance,
        }

    except Exception as e:

        conn.rollback()

        return {
            "success": False,
            "message": str(e),
        }

    finally:

        conn.close()


# =========================================================
# GET USER DEPOSITS
# =========================================================

def get_user_deposits(user_id):

    conn = get_db()
    cur = conn.cursor()

    cur.execute(
        """
        SELECT *
        FROM deposits
        WHERE user_id = ?
        ORDER BY id DESC
        """,
        (user_id,),
    )

    rows = cur.fetchall()

    conn.close()

    return rows


# =========================================================
# GET DEPOSIT BY FLW REF
# =========================================================

def get_deposit_by_flw_ref(flw_ref):

    conn = get_db()
    cur = conn.cursor()

    cur.execute(
        """
        SELECT *
        FROM deposits
        WHERE flw_ref = ?
        LIMIT 1
        """,
        (flw_ref,),
    )

    row = cur.fetchone()

    conn.close()

    return row


# =========================================================
# CANCEL
# =========================================================

def cancel_deposit(tx_ref):

    conn = get_db()
    cur = conn.cursor()

    cur.execute(
        """
        UPDATE deposits

        SET status = 'cancelled'

        WHERE tx_ref = ?

        AND status = 'pending'
        """,
        (tx_ref,),
    )

    changed = cur.rowcount

    conn.commit()
    conn.close()

    return changed > 0
