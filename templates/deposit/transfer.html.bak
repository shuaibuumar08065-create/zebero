<script>

const txRef = "{{ tx_ref }}";

const expiresAt =
    new Date(
        "{{ expires_at }}"
    ).getTime();

const timeElement =
    document.getElementById(
        "timeRemaining"
    );

const successMessage =
    document.getElementById(
        "successMessage"
    );

const expiredMessage =
    document.getElementById(
        "expiredMessage"
    );

const paymentStatus =
    document.getElementById(
        "paymentStatus"
    );


// =========================================================
// COPY ACCOUNT
// =========================================================

function copyAccount() {

    const account =
        document
            .getElementById(
                "accountNumber"
            )
            .innerText
            .trim();

    if (
        navigator.clipboard
        && navigator.clipboard.writeText
    ) {

        navigator.clipboard
            .writeText(account)
            .then(function () {

                alert(
                    "Account number copied."
                );

            })
            .catch(function () {

                alert(
                    "Unable to copy account number."
                );

            });

    } else {

        alert(
            "Copy is not supported on this browser."
        );

    }
}


// =========================================================
// COUNTDOWN
// =========================================================

function updateCountdown() {

    const now =
        new Date().getTime();

    const difference =
        expiresAt - now;

    if (difference <= 0) {

        timeElement.innerText =
            "Time expired";

        checkPaymentStatus();

        return;
    }

    const minutes =
        Math.floor(
            difference / 60000
        );

    const seconds =
        Math.floor(
            (difference % 60000) / 1000
        );

    timeElement.innerText =
        "Time remaining: "
        + String(minutes).padStart(2, "0")
        + ":"
        + String(seconds).padStart(2, "0");
}

updateCountdown();

setInterval(
    updateCountdown,
    1000
);


// =========================================================
// CHECK PAYMENT
// =========================================================

let checking = false;

async function checkPaymentStatus() {

    if (checking) {
        return;
    }

    checking = true;

    try {

        const response =
            await fetch(
                "/deposit/status/"
                + encodeURIComponent(txRef),
                {
                    method: "GET",
                    cache: "no-store",
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

        const data =
            await response.json();

        console.log(
            "DEPOSIT STATUS:",
            data
        );


        // -------------------------------------------------
        // SUCCESS
        // -------------------------------------------------

        if (
            data.status ===
            "successful"
        ) {

            paymentStatus.style.display =
                "none";

            successMessage.style.display =
                "block";

            setTimeout(
                function () {

                    window.location.href =
                        "{{ url_for('dashboard') }}";

                },
                1500
            );

            return;
        }


        // -------------------------------------------------
        // EXPIRED
        // -------------------------------------------------

        if (
            data.status ===
            "expired"
        ) {

            paymentStatus.style.display =
                "none";

            expiredMessage.style.display =
                "block";

            return;
        }

    }
    catch (error) {

        console.log(
            "Payment status error:",
            error
        );

    }
    finally {

        checking = false;
    }
}


// =========================================================
// FIRST CHECK
// =========================================================

checkPaymentStatus();


// =========================================================
// EVERY 5 SECONDS
// =========================================================

setInterval(
    checkPaymentStatus,
    5000
);

</script>
