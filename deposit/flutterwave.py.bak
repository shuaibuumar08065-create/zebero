import os
import requests
from dotenv import load_dotenv

load_dotenv()

FLW_SECRET_KEY = os.getenv("FLW_SECRET_KEY")

BASE_URL = "https://api.flutterwave.com/v3"

HEADERS = {
    "Authorization": f"Bearer {FLW_SECRET_KEY}",
    "Content-Type": "application/json",
    "Accept": "application/json",
}


def _error(message, response=None):
    result = {
        "status": "error",
        "message": message,
    }

    if response is not None:
        result["http_status"] = response.status_code

        try:
            result["response"] = response.json()
        except Exception:
            result["response"] = response.text

    return result


# =========================================================
# CREATE BANK TRANSFER CHARGE
# =========================================================

def create_bank_transfer(
    tx_ref,
    amount,
    email,
    name,
    phone_number=None,
):
    if not FLW_SECRET_KEY:
        return _error("FLW_SECRET_KEY is missing from .env")

    url = f"{BASE_URL}/charges?type=bank_transfer"

    payload = {
        "tx_ref": tx_ref,
        "amount": float(amount),
        "currency": "NGN",
        "email": email,
        "fullname": name,
        "narration": "ZEBERO",
    }

    if phone_number:
        payload["phone_number"] = phone_number

    try:
        response = requests.post(
            url,
            headers=HEADERS,
            json=payload,
            timeout=30,
        )

        try:
            return response.json()
        except ValueError:
            return _error(
                "Flutterwave returned an invalid response.",
                response,
            )

    except requests.RequestException as e:
        return _error(str(e))


# =========================================================
# VERIFY TRANSACTION BY ID
# =========================================================

def verify_payment(transaction_id):
    if not FLW_SECRET_KEY:
        return _error("FLW_SECRET_KEY is missing from .env")

    url = f"{BASE_URL}/transactions/{transaction_id}/verify"

    try:
        response = requests.get(
            url,
            headers=HEADERS,
            timeout=30,
        )

        try:
            return response.json()
        except ValueError:
            return _error(
                "Flutterwave returned an invalid response.",
                response,
            )

    except requests.RequestException as e:
        return _error(str(e))


# =========================================================
# VERIFY TRANSACTION BY TX_REF
#
# IMPORTANT:
# This is used as a backup when webhook has not arrived.
# =========================================================

def verify_by_reference(tx_ref):
    if not FLW_SECRET_KEY:
        return _error("FLW_SECRET_KEY is missing from .env")

    url = f"{BASE_URL}/transactions/verify_by_reference"

    params = {
        "tx_ref": tx_ref,
    }

    try:
        response = requests.get(
            url,
            headers=HEADERS,
            params=params,
            timeout=30,
        )

        try:
            return response.json()
        except ValueError:
            return _error(
                "Flutterwave returned an invalid response.",
                response,
            )

    except requests.RequestException as e:
        return _error(str(e))


# =========================================================
# VERIFY CHARGE
#
# New Flutterwave charge IDs such as chg_xxxxx
# =========================================================

def verify_charge(transaction_id):
    return verify_payment(transaction_id)


# =========================================================
# GET NIGERIAN BANKS
# =========================================================

def get_banks():
    if not FLW_SECRET_KEY:
        return _error("FLW_SECRET_KEY is missing from .env")

    url = f"{BASE_URL}/banks/NG"

    try:
        response = requests.get(
            url,
            headers=HEADERS,
            timeout=30,
        )

        try:
            return response.json()
        except ValueError:
            return _error(
                "Flutterwave returned an invalid response.",
                response,
            )

    except requests.RequestException as e:
        return _error(str(e))


# =========================================================
# GET TRANSFER FEE
# =========================================================

def transfer_fee(amount):
    if not FLW_SECRET_KEY:
        return _error("FLW_SECRET_KEY is missing from .env")

    url = f"{BASE_URL}/transactions/fee"

    params = {
        "amount": amount,
        "currency": "NGN",
        "payment_type": "bank_transfer",
    }

    try:
        response = requests.get(
            url,
            headers=HEADERS,
            params=params,
            timeout=30,
        )

        try:
            return response.json()
        except ValueError:
            return _error(
                "Flutterwave returned an invalid response.",
                response,
            )

    except requests.RequestException as e:
        return _error(str(e))


# =========================================================
# CREATE BANK TRANSFER / PAYOUT
# =========================================================

def create_transfer(
    account_bank,
    account_number,
    amount,
    narration,
    reference,
):
    if not FLW_SECRET_KEY:
        return _error("FLW_SECRET_KEY is missing from .env")

    url = f"{BASE_URL}/transfers"

    payload = {
        "account_bank": account_bank,
        "account_number": account_number,
        "amount": amount,
        "currency": "NGN",
        "reference": reference,
        "narration": narration,
        "debit_currency": "NGN",
    }

    try:
        response = requests.post(
            url,
            headers=HEADERS,
            json=payload,
            timeout=30,
        )

        try:
            return response.json()
        except ValueError:
            return _error(
                "Flutterwave returned an invalid response.",
                response,
            )

    except requests.RequestException as e:
        return _error(str(e))
