# ==========================================
# FLUTTERWAVE WEBHOOK
# ==========================================

@app.route(
    "/flutterwave/webhook",
    methods=["POST"],
)
def flutterwave_webhook():

    from deposit.flutterwave import verify_payment
    from deposit.models import complete_deposit

    data = request.get_json(
        silent=True
    ) or {}

    transaction_id = (
        data.get("data", {}).get("id")
        or data.get("id")
    )

    if not transaction_id:
        return "OK", 200

    # --------------------------------------
    # Verify transaction directly with
    # Flutterwave
    # --------------------------------------

    result = verify_payment(
        transaction_id
    )

    if result.get("status") != "success":
        return "OK", 200

    payment = result.get(
        "data",
        {}
    )

    if payment.get("status") != "successful":
        return "OK", 200

    tx_ref = payment.get(
        "tx_ref"
    )

    flw_ref = str(
        payment.get(
            "id",
            transaction_id
        )
    )

    if not tx_ref:
        return "OK", 200

    # --------------------------------------
    # Complete deposit
    # --------------------------------------

    complete_deposit(
        tx_ref,
        flw_ref,
    )

    return "OK", 200


