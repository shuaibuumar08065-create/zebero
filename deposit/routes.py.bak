from flask import (
    Blueprint,
    render_template,
    request,
    session,
    redirect,
    url_for,
    jsonify,
)

from deposit.models import (
    create_deposit,
    save_virtual_account,
    get_deposit,
    expire_deposit_if_needed,
    complete_deposit,
)

from deposit.flutterwave import (
    create_bank_transfer,
    verify_by_reference,
)


deposit_bp = Blueprint(
    "deposit",
    __name__,
)


# =========================================================
# DEPOSIT PAGE
# =========================================================

@deposit_bp.route("/deposit")
def deposit():

    if "user" not in session:
        return redirect(
            url_for("index")
        )

    return render_template(
        "deposit/index.html"
    )


# =========================================================
# CREATE BANK TRANSFER
# =========================================================

@deposit_bp.route(
    "/deposit/create",
    methods=["POST"],
)
def deposit_create():

    if "user" not in session:
        return redirect(
            url_for("index")
        )

    try:

        amount = float(
            request.form.get(
                "amount",
                0,
            )
        )

    except (
        TypeError,
        ValueError,
    ):

        return (
            "Invalid deposit amount.",
            400,
        )

    if amount < 1000:

        return (
            "Minimum deposit is ₦1000.",
            400,
        )

    user = session["user"]

    user_id = user["id"]
    email = user["email"]

    username = "ZEBERO"

    # -----------------------------------------------------
    # Local deposit
    # -----------------------------------------------------

    payment = create_deposit(
        user_id,
        amount,
    )

    tx_ref = payment["tx_ref"]

    # -----------------------------------------------------
    # Flutterwave
    # -----------------------------------------------------

    result = create_bank_transfer(
        tx_ref=tx_ref,
        amount=amount,
        email=email,
        name=username,
    )

    if result.get("status") != "success":

        return (
            "<h3>Flutterwave Error</h3>"
            "<pre>"
            f"{result}"
            "</pre>",
            400,
        )

    authorization = (
        result
        .get("meta", {})
        .get("authorization", {})
    )

    account_number = authorization.get(
        "transfer_account"
    )

    bank_name = authorization.get(
        "transfer_bank"
    )

    transfer_amount = authorization.get(
        "transfer_amount"
    )

    transfer_note = authorization.get(
        "transfer_note",
        "Please make a bank transfer to ZEBERO",
    )

    expiration = authorization.get(
        "account_expiration",
        "",
    )

    if not account_number:

        return (
            "<h3>Bank account was not generated.</h3>"
            "<pre>"
            f"{result}"
            "</pre>",
            400,
        )

    if not transfer_amount:
        transfer_amount = amount

    save_virtual_account(
        tx_ref,
        account_number,
        bank_name or "Flutterwave MFB",
        "ZEBERO",
    )

    return render_template(
        "deposit/transfer.html",

        amount=float(
            transfer_amount
        ),

        account_number=account_number,

        bank_name=(
            bank_name
            or "Flutterwave MFB"
        ),

        tx_ref=tx_ref,

        transfer_note=transfer_note,

        expiration=expiration,

        expires_at=payment[
            "expires_at"
        ].isoformat(),
    )


# =========================================================
# CHECK DEPOSIT STATUS
#
# IMPORTANT:
# This route now checks SQLite AND Flutterwave.
# =========================================================

@deposit_bp.route(
    "/deposit/status/<tx_ref>",
    methods=["GET"],
)
def deposit_status(tx_ref):

    if "user" not in session:

        return jsonify({
            "success": False,
            "message": "Not logged in.",
        }), 401

    deposit = get_deposit(tx_ref)

    if not deposit:

        return jsonify({
            "success": False,
            "message": "Deposit not found.",
        }), 404

    # -----------------------------------------------------
    # Security
    # -----------------------------------------------------

    if int(
        deposit["user_id"]
    ) != int(
        session["user"]["id"]
    ):

        return jsonify({
            "success": False,
            "message": "Unauthorized.",
        }), 403

    # -----------------------------------------------------
    # Expire locally
    # -----------------------------------------------------

    expire_deposit_if_needed(
        tx_ref
    )

    deposit = get_deposit(
        tx_ref
    )

    # -----------------------------------------------------
    # Already successful
    # -----------------------------------------------------

    if deposit["status"] == "successful":

        return jsonify({
            "success": True,
            "status": "successful",
            "amount": float(
                deposit["amount"]
            ),
            "tx_ref": tx_ref,
            "new_balance": None,
        })

    # -----------------------------------------------------
    # If still pending:
    # ASK FLUTTERWAVE
    # -----------------------------------------------------

    if deposit["status"] == "pending":

        print(
            f"\nChecking Flutterwave by tx_ref: {tx_ref}"
        )

        verification = verify_by_reference(
            tx_ref
        )

        print(
            "FLUTTERWAVE REFERENCE VERIFICATION:"
        )

        print(
            verification
        )

        if isinstance(
            verification,
            dict,
        ):

            if verification.get(
                "status"
            ) == "success":

                data = verification.get(
                    "data",
                    {},
                )

                if isinstance(
                    data,
                    dict,
                ):

                    flw_status = str(
                        data.get(
                            "status",
                            "",
                        )
                    ).lower()

                    flw_tx_ref = (
                        data.get("tx_ref")
                        or data.get("reference")
                    )

                    flw_currency = str(
                        data.get(
                            "currency",
                            "",
                        )
                    ).upper()

                    try:

                        flw_amount = float(
                            data.get(
                                "amount",
                                0,
                            )
                        )

                    except (
                        TypeError,
                        ValueError,
                    ):

                        flw_amount = 0

                    local_amount = float(
                        deposit["amount"]
                    )

                    print(
                        f"STATUS: {flw_status}"
                    )

                    print(
                        f"TX_REF: {flw_tx_ref}"
                    )

                    print(
                        f"AMOUNT: {flw_amount}"
                    )

                    # -------------------------------------------------
                    # STRICT CHECK
                    # -------------------------------------------------

                    if (
                        flw_status
                        in (
                            "successful",
                            "succeeded",
                        )
                        and flw_tx_ref == tx_ref
                        and flw_currency == "NGN"
                        and flw_amount >= local_amount
                    ):

                        flw_ref = (
                            data.get(
                                "flw_ref"
                            )
                            or str(
                                data.get(
                                    "id",
                                    ""
                                )
                            )
                        )

                        result = complete_deposit(
                            tx_ref=tx_ref,
                            flw_ref=flw_ref,
                        )

                        print(
                            "AUTO DEPOSIT RESULT:"
                        )

                        print(
                            result
                        )

                        if result.get(
                            "success"
                        ):

                            return jsonify({
                                "success": True,
                                "status": "successful",
                                "amount": local_amount,
                                "tx_ref": tx_ref,
                                "new_balance": result.get(
                                    "new_balance"
                                ),
                            })

    # -----------------------------------------------------
    # Refresh after verification
    # -----------------------------------------------------

    deposit = get_deposit(
        tx_ref
    )

    return jsonify({
        "success": True,
        "status": deposit["status"],
        "amount": float(
            deposit["amount"]
        ),
        "tx_ref": deposit["tx_ref"],
        "expires_at": str(
            deposit["expires_at"]
        ),
    })
